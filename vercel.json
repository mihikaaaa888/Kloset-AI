{
  "buildCommand": "npm run build",
  "installCommand": "ONNXRUNTIME_NODE_INSTALL=skip npm install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/inactive-accounts",
      "schedule": "0 3 * * *"
    }
  ]
}
