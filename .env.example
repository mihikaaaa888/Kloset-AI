# Kloset environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ── Supabase (required for auth + database) ───────────────────────────────────
# Find these in your Supabase project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Required by the server-side account deletion endpoint. Never expose this as a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Native app API origin (required for Capacitor iOS/Android builds) ────────
# Set this to the deployed Kloset site origin when building a native app.
# Leave unset for web builds (same-origin /api routes continue to work).
# VITE_API_BASE_URL=https://your-kloset-site.netlify.app

# ── Groq (Phase D — AI image analysis, free tier) ────────────────────────────
# Get yours free at: console.groq.com → API Keys → Create API Key
# Do NOT prefix with VITE_ — this is server-side only and must never reach the browser.
GROQ_API_KEY=
# Optional model override for garment and Kaia image analysis.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── Claude (fallback for the stylist chat if Groq errors or is rate-limited) ─
# Get yours at: console.anthropic.com → API Keys
# Do NOT prefix with VITE_ — this is server-side only and must never reach the browser.
CLAUDE_API_KEY=

# ── Exa (live web shopping search — real Zara/H&M product links) ────────────
# Get yours at: exa.ai → API Keys
# Do NOT prefix with VITE_ — this is server-side only and must never reach the browser.
EXA_API_KEY=

# ── PhotoRoom (optional garment cutout edge refinement) ─────────────────────
# Create an API key in your PhotoRoom developer account.
# Server-side only; never prefix this with VITE_ or expose it in the browser.
PHOTOROOM_API_KEY=

# Optional: override the API server port (default: 3001)
# PORT=3001

# ── Inactive-account job (/api/cron/inactive-accounts, server-side only) ─────
# Vercel sends CRON_SECRET to the job automatically. Use a long random string.
CRON_SECRET=
# Sends the 30-day warning email. EMAIL_FROM must use a domain verified in Resend,
# e.g. Kloset <noreply@trykloset.com>. Without these the job refuses to run.
RESEND_API_KEY=
EMAIL_FROM=
